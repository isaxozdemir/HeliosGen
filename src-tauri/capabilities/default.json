{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window permissions, spawning the bundled Node server sidecar shim, and saving a generated asset to a user-chosen path. The window navigates to the sidecar's loopback origin, which Tauri treats as remote, so the capability has to name it for IPC to reach the page.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "helios-node",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "helios-node",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$HOME/Movies/**"
        },
        {
          "path": "$HOME/Pictures/**"
        }
      ]
    }
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  }
}
